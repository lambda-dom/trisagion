cabal-version:      3.0
name:               trisagion
version:            0.0.1.0
synopsis:           A parsing and serializing library.
description:        Please see the README on GitHub at <https://github.com/lambda-dom/trisagion#readme>
category:           Parsing
homepage:           https://github.com/lambda-dom/trisagion#readme
author:             lambda-dom
license:            BSD-3-Clause
license-file:       LICENSE
maintainer:         grodrigues.math@gmail.com
copyright:          2025 G. Rodrigues
build-type:         Simple
tested-with:
    GHC == {9.10.3}
extra-doc-files:
    LICENSE
    README.md
    CHANGELOG.md

source-repository head
    type: git
    location: https://github.com/lambda-dom/trisagion


common common-fields
    default-language: GHC2021
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-export-lists
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Wmissing-deriving-strategies
        -Wunused-packages
        -- Prepare for dependent types.
        -Wterm-variable-capture
    build-depends:
        -- GHC >= 9.10 && < 9.12
        base >=4.20 && <4.21,

library
    import:
        common-fields
    default-extensions:
        DerivingStrategies
        DerivingVia
        FunctionalDependencies
        RequiredTypeArguments
    hs-source-dirs:
        src
    build-depends:
        -- Libraries.
        mtl                >=2.3   && <2.4,
        bytestring         >=0.12  && <0.13,
        containers         >=0.7   && <0.8,
        text               >=2.1   && <2.2,
        vector             >=0.13  && <0.14,
        contravariant      >=1.5   && <1.6,
        selective          >=0.7   && <0.8,
        optics-core        >=0.4.2 && <0.4.3,
        -- Non-hackage libraries.
        mono               >=0.1   && <0.2,
        optics-conversions >=0.1   && <0.2,
    exposed-modules:
        Trisagion.Utils.Either
        Trisagion.Utils.List
        Trisagion.Types.Result
        Trisagion.Types.ParseError
        Trisagion.Streams.Counter
        Trisagion.Typeclasses.Source
        Trisagion.Typeclasses.HasOffset
        Trisagion.Typeclasses.Split
        Trisagion.Typeclasses.Sink
        Trisagion.Serializers.Combinators
        Trisagion.Typeclasses.Parsers.Binary
        Trisagion.Typeclasses.Serializers.Binary
        Trisagion.Parser
        Trisagion.Parsers.Combinators
        Trisagion.Parsers.Source
        Trisagion.Parsers.HasOffset
        Trisagion.Parsers.ParseError
        Trisagion.Parsers.Split
        Trisagion.Parsers.Char
        Trisagion.Serializer

test-suite trisagion-tests
    import:
        common-fields
    hs-source-dirs:
        tests
    type: exitcode-stdio-1.0
    main-is: Main.hs
    build-depends:
        -- mono,
        -- Libraries.
        tasty         >=1.5 && <1.6,
        -- falsify       >=0.4 && <0.5,
        -- tasty-falsify >=0.1 && <0.2,
    other-modules:
